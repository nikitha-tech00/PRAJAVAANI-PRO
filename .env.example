# PRAJAVAANI PRO Configuration Environment Variables
PORT=5000
NODE_ENV=production

# Supabase Configuration (PostgreSQL, Realtime & Storage)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Database Configuration (Relational / PostgreSQL Architecture)
DATABASE_URL=postgresql://prajavaani_user:secure_password@localhost:5432/prajavaani_pro_db

# Authentication Secrets & Sessions
AUTH_SECRET=super_secret_jwt_hmac_sha256_key_prajavaani_civic_2026
SESSION_EXPIRY_HOURS=24

# Citizen Mobile OTP Provider (SMS & WhatsApp Business Architecture)
OTP_PROVIDER_KEY=mock_otp_gateway_key_sms_whatsapp
SMS_PROVIDER_KEY=mock_telecom_sms_gateway_key
WHATSAPP_PROVIDER_KEY=mock_meta_whatsapp_business_cloud_api_key

# Official Government SSO & MFA Architecture
GOV_SSO_CLIENT_ID=parichay_or_meri_pehchan_gov_sso_id
GOV_SSO_CLIENT_SECRET=parichay_or_meri_pehchan_gov_sso_secret

# AI Service Provider (Independent Abstraction - Gemini / Vertex / Claude / OpenAI)
AI_API_KEY=mock_or_actual_gemini_api_key_ai_service
AI_MODEL_NAME=gemini-1.5-pro

# Map Provider Service Abstraction (OpenStreetMap / CartoDB / Mapbox / Bhuvan ISRO)
MAP_API_KEY=carto_or_bhuvan_isro_gis_layer_key

# Object Storage for Photographic Proof (S3 / Cloud Storage / MinIO)
STORAGE_BUCKET_NAME=prajavaani-civic-evidence-storage
